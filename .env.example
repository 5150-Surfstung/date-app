# Supabase — leave unset in development to use local .data/ storage instead.
NEXT_PUBLIC_SUPABASE_URL=
# Either key works for the intake API. The anon key is RLS-restricted to
# insert-only (submit applications, upload intake media — never read).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
